# =============================================================================
# GridTokenX Trading - Environment Configuration
# =============================================================================
# DO NOT commit .env files with sensitive data to version control
# =============================================================================
# === App Configuration ===
NEXT_PUBLIC_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Mapbox Configuration (for Energy Grid Map visualization)
# -----------------------------------------------------------------------------
# Get your token from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# -----------------------------------------------------------------------------
# Solana Network Configuration
# -----------------------------------------------------------------------------
# Network options: localnet, devnet, testnet, mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=localnet

# RPC URL for Solana network
# - Localnet: http://localhost:8899
# - Devnet: https://api.devnet.solana.com
# - Mainnet: https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://apisix.gridtokenx-coresystem.orb.local/api/v1/rpc

# WebSocket URL for Solana network
# - Localnet: ws://localhost:8900
# - Devnet: wss://api.devnet.solana.com
# - Mainnet: wss://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://apisix.gridtokenx-coresystem.orb.local/api/v1/rpc-ws

# -----------------------------------------------------------------------------
# Program IDs (from Anchor.toml - localnet)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_REGISTRY_PROGRAM_ID=FcSd5x4X1nzJMKLZC4tMZXnQ1ipLrGsEfeoH8N4mvJX7
NEXT_PUBLIC_ENERGY_TOKEN_PROGRAM_ID=6FZKcVKCLFSNLMxypFJGU4K14xUBnxNW9VAuKGhmqjGX
NEXT_PUBLIC_TRADING_PROGRAM_ID=CnWDEUhTvSixeLSyViWgAnnu9YouBAYVGcrrFm1s9WcX
NEXT_PUBLIC_ORACLE_PROGRAM_ID=64Vgos61STZ8pW9NnHi2iGtXMTQr7NqBoMorK6Zg8RJU
NEXT_PUBLIC_GOVERNANCE_PROGRAM_ID=FokVuBSPXP11aeL7VZWd8n8aVAhWqVpyPZETToSxdvTS

# Token Mints
NEXT_PUBLIC_ENERGY_TOKEN_MINT=GktSLt9dFsTrSSxikMEQRNeQXhpN9NxUn4m9teixctVS

# -----------------------------------------------------------------------------
# API Gateway Configuration
# -----------------------------------------------------------------------------
# Base URL for the GridTokenX# API Configuration
NEXT_PUBLIC_API_BASE_URL=https://apisix.gridtokenx-coresystem.orb.local
NEXT_PUBLIC_API_URL=https://apisix.gridtokenx-coresystem.orb.local

# WebSocket base URL for real-time updates
NEXT_PUBLIC_WS_BASE_URL=wss://apisix.gridtokenx-coresystem.orb.local

# -----------------------------------------------------------------------------
# Pyth Price Service (for real-time price feeds)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PYTH_PRICE_SERVICE_URL=https://hermes.pyth.network

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable analytics tracking
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable debug mode (shows additional console logs)
NEXT_PUBLIC_ENABLE_DEBUG=true

# Show developer tools in the UI
NEXT_PUBLIC_SHOW_DEV_TOOLS=true
