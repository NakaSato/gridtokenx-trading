{
  "name": "gridtokenx-trading",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bun run build:wasm && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "build:wasm": "cd wasm && wasm-pack build --target web --out-dir ../lib/wasm --out-name main && cp ../lib/wasm/main_bg.wasm ../public/main.wasm && (git checkout -- ../lib/wasm/.gitignore 2>/dev/null || true)",
    "format": "prettier --write .",
    "analyze": "ANALYZE=true next build --webpack",
    "clean": "rm -rf .next",
    "check:bundle": "node scripts/check-bundle-size.js",
    "build:check": "bun run build && bun run check:bundle"
